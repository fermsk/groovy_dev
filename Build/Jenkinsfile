pipeline {
    agent any

    environment {
        // Укажите ваш логин на Docker Hub
        DOCKER_HUB_USER = 'femsk'
        DOCKER_CREDS_ID = 'a7bf1f54-c276-4aa4-a625-e18f6dde6994'
    }

    stages {
        stage('Prepare') {
            steps {
                // Вывод общей информации перед стартом
                script {
                    PrintSysTime("Global Start")
                    // Даем права на выполнение gradle wrapper, если нужно
                    sh "chmod +x ./gradlew"
                }
            }
        }

        stage('Parallel Build & Deploy Modules') {
            parallel {
                stage('HW02') {
                    steps { script { processModule("hw02-gradle") } }
                }
                stage('HW03') {
                    steps { script { processModule("hw03-gradle") } }
                }
                stage('HW07') {
                    steps { script { processModule("hw07-gradle") } }
                }
                stage('HW08') {
                    steps { script { processModule("hw08-dsl") } }
                }
            }
        }
    }
}

// Основная логика обработки модуля
def processModule(moduleName) {
    // 1. Вызов кастомной функции PrintSysTime
    PrintSysTime(moduleName)

    // 2. Сборка JAR и Тестирование через Gradle
    // Используем конструкцию :moduleName:build для сборки конкретного проекта
    echo "Building module: ${moduleName}"
    sh "./gradlew :${moduleName}:clean :${moduleName}:build"

    // 3. Создание Docker-образа
    // Предполагается, что Dockerfile лежит в корне папки модуля
    def imageName = "${DOCKER_HUB_USER}/${moduleName}:${env.BRANCH_NAME.replace('/', '-')}-${env.BUILD_ID}"

    dir(moduleName) {
        def customImage = docker.build(imageName, "-f Dockerfile .")

        // 4. Деплой в Docker Hub
        docker.withRegistry('index.docker.io', DOCKER_CREDS_ID) {
            customImage.push()
            customImage.push('latest')
        }

        // 5. Вызов кастомной функции подсчета файлов
        countFiles(moduleName)
    }
}

// Кастомная функция: Вывод времени и ветки
def PrintSysTime(contextName) {
    def now = new Date().format("yyyy-MM-dd HH:mm:ss", TimeZone.getTimeZone('Europe/Moscow'))
    echo """
    ****************************************************
    TIME: ${now}
    BRANCH: ${env.BRANCH_NAME}
    MODULE/CONTEXT: ${contextName}
    ****************************************************
    """
}

// Кастомная функция: Подсчет файлов в папке модуля
def countFiles(modulePath) {
    // Находимся внутри dir(moduleName), поэтому считаем файлы в текущей папке
    def fileCount = sh(script: "find . -maxdepth 1 -not -path '*/.*' | wc -l", returnStdout: true).trim()
    echo "RESULT: Module '${modulePath}' has ${fileCount} visible files/folders in the root."
}